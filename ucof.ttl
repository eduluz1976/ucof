##############################################################################
# HLS CLAUSE INSTANCES — Shared ISO High Level Structure clauses (4–10)
# These are norm-independent; each CertifiableNorm's HLS requirements
# instantiate HLSRequirement and point to these clauses.
##############################################################################

ucof-norm:HLS-Clause4 a ucof-norm:HLSClause ;
    ucof-norm:clauseId    "4" ;
    ucof-norm:clauseTitle "Context of the Organization" ;
    rdfs:label "HLS Clause 4 — Context of the Organization" .

ucof-norm:HLS-Clause4-1 a ucof-norm:HLSClause ;
    ucof-norm:clauseId    "4.1" ;
    ucof-norm:clauseTitle "Understanding the organization and its context" ;
    ucof-norm:hasParentClause ucof-norm:HLS-Clause4 ;
    rdfs:label "HLS 4.1 — Understanding context" .

ucof-norm:HLS-Clause4-2 a ucof-norm:HLSClause ;
    ucof-norm:clauseId    "4.2" ;
    ucof-norm:clauseTitle "Understanding the needs and expectations of interested parties" ;
    ucof-norm:hasParentClause ucof-norm:HLS-Clause4 ;
    rdfs:label "HLS 4.2 — Interested parties" .

ucof-norm:HLS-Clause4-3 a ucof-norm:HLSClause ;
    ucof-norm:clauseId    "4.3" ;
    ucof-norm:clauseTitle "Determining the scope of the management system" ;
    ucof-norm:hasParentClause ucof-norm:HLS-Clause4 ;
    rdfs:label "HLS 4.3 — Scope" .

ucof-norm:HLS-Clause5 a ucof-norm:HLSClause ;
    ucof-norm:clauseId    "5" ;
    ucof-norm:clauseTitle "Leadership" ;
    rdfs:label "HLS Clause 5 — Leadership" .

ucof-norm:HLS-Clause6 a ucof-norm:HLSClause ;
    ucof-norm:clauseId    "6" ;
    ucof-norm:clauseTitle "Planning" ;
    rdfs:label "HLS Clause 6 — Planning" .

ucof-norm:HLS-Clause6-1 a ucof-norm:HLSClause ;
    ucof-norm:clauseId    "6.1" ;
    ucof-norm:clauseTitle "Actions to address risks and opportunities" ;
    ucof-norm:hasParentClause ucof-norm:HLS-Clause6 ;
    rdfs:label "HLS 6.1 — Risks and opportunities" .

ucof-norm:HLS-Clause7 a ucof-norm:HLSClause ;
    ucof-norm:clauseId    "7" ;
    ucof-norm:clauseTitle "Support" ;
    rdfs:label "HLS Clause 7 — Support" .

ucof-norm:HLS-Clause7-5 a ucof-norm:HLSClause ;
    ucof-norm:clauseId    "7.5" ;
    ucof-norm:clauseTitle "Documented information" ;
    ucof-norm:hasParentClause ucof-norm:HLS-Clause7 ;
    rdfs:label "HLS 7.5 — Documented information" .

ucof-norm:HLS-Clause8 a ucof-norm:HLSClause ;
    ucof-norm:clauseId    "8" ;
    ucof-norm:clauseTitle "Operation" ;
    rdfs:label "HLS Clause 8 — Operation" .

ucof-norm:HLS-Clause9 a ucof-norm:HLSClause ;
    ucof-norm:clauseId    "9" ;
    ucof-norm:clauseTitle "Performance Evaluation" ;
    rdfs:label "HLS Clause 9 — Performance Evaluation" .

ucof-norm:HLS-Clause9-2 a ucof-norm:HLSClause ;
    ucof-norm:clauseId    "9.2" ;
    ucof-norm:clauseTitle "Internal audit" ;
    ucof-norm:hasParentClause ucof-norm:HLS-Clause9 ;
    rdfs:label "HLS 9.2 — Internal audit" .

ucof-norm:HLS-Clause9-3 a ucof-norm:HLSClause ;
    ucof-norm:clauseId    "9.3" ;
    ucof-norm:clauseTitle "Management review" ;
    ucof-norm:hasParentClause ucof-norm:HLS-Clause9 ;
    rdfs:label "HLS 9.3 — Management review" .

ucof-norm:HLS-Clause10 a ucof-norm:HLSClause ;
    ucof-norm:clauseId    "10" ;
    ucof-norm:clauseTitle "Improvement" ;
    rdfs:label "HLS Clause 10 — Improvement" .

ucof-norm:HLS-Clause10-2 a ucof-norm:HLSClause ;
    ucof-norm:clauseId    "10.2" ;
    ucof-norm:clauseTitle "Nonconformity and corrective action" ;
    ucof-norm:hasParentClause ucof-norm:HLS-Clause10 ;
    rdfs:label "HLS 10.2 — Nonconformity and corrective action" .


##############################################################################
# SAMPLE HLS REQUIREMENT — Documented Information (HLS 7.5)
# Demonstrates cross-norm consolidation: one HLSRequirement satisfies
# the documented-information clause across ISO 9001, 27001, and 42001.
##############################################################################

ucof-norm:HLS-REQ-7-5-DocumentControl a ucof-norm:HLSRequirement ;
    ucof-norm:requirementId   "hls/7.5/document-control" ;
    ucof-norm:requirementText "The organization shall control documented information required by the management system and by this document." ;
    ucof-norm:hasObligationLevel ucof:SHALL ;
    ucof-norm:derivedFromClause ucof-norm:HLS-Clause7-5 ;
    rdfs:label "HLS 7.5 — Document Control Requirement" ;
    rdfs:comment "Shared by ISO 9001:7.5, ISO 27001:7.5, ISO 42001:7.5, ISO 45001:7.5, ISO 14001:7.5. A single Document Control Policy satisfies all." .

# Cross-norm mapping example: ISO 27001 6.1.2 ↔ ISO 42001 6.1 ↔ ISO 31000 6.4
ucof-norm:XMAP-RiskAssessment-27001-42001 a ucof-norm:CrossNormMapping ;
    ucof-norm:mappingRationale "Both ISO 27001 Clause 6.1.2 and ISO 42001 Clause 6.1 require a risk assessment process with identification, analysis, and evaluation steps. A single Risk Assessment Procedure can address both when scoped to cover information security risks and AI-specific risks respectively." ;
    rdfs:label "Cross-mapping: ISO 27001 6.1.2 ↔ ISO 42001 6.1 (Risk Assessment)" .

ucof-norm:XMAP-InternalAudit-HLS a ucof-norm:CrossNormMapping ;
    ucof-norm:mappingRationale "HLS Clause 9.2 Internal Audit is structurally identical across ISO 9001, 27001, 42001, 45001, and 14001. A single integrated internal audit programme satisfies all norms in scope." ;
    rdfs:label "Cross-mapping: HLS 9.2 Internal Audit — all HLS norms" .
