    rdfs:label "ISO/IEC 22989:2022" .

ucof-norm:ISO42001-2023 a ucof-norm:CertifiableNorm ;
    ucof-norm:normId      "iso42001-2023" ;
    ucof-norm:normTitle   "ISO/IEC 42001:2023 Artificial Intelligence Management Systems" ;
    ucof-norm:normVersion "2023" ;
    ucof-norm:normDomain  "AI Governance" ;
    ucof-norm:hasDependency ucof-norm:ISO22989-2022 ;
    rdfs:label "ISO/IEC 42001:2023" .

